+  const fields = splitRuleFields(rule)
+  if (!['AND', 'OR', 'NOT'].includes((fields[0] ?? '').toUpperCase())) return []
+  return collectMihomoRuleConditions(fields.slice(1, payload ? undefined : getRuleTargetIndex(fields)).join(','))
